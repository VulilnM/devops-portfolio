@using Frontend.Dto
@page "/analyze"
@inject IHttpClientFactory HttpClientFactory
@implements IDisposable

<PageTitle>Car Analyzer</PageTitle>

<h1>Vehicle Analysis</h1>

<div class="mb-3">
<label>Make</label>
    <input class="form-control" @bind="make" placeholder="e.g., Audi" />
</div>

<div class="mb-3">
    <label>Model</label>
    <input class="form-control" @bind="model" placeholder="e.g., A4" />
</div>

<div class="mb-3">
    <label>Year</label>
    <input class="form-control" type="number" @bind="year" placeholder="e.g., 2020" />
</div>

<button class="btn btn-primary" @onclick="StartAnalysis" disabled="@(isSubmitting || isAnalyzing)">
    Analyze
</button>

@if (errorMessage is not null)
{
    <p class="text-danger mt-3">@errorMessage</p>
}

@if (searchRequestId is not null)
{
    <hr />

   @if (currentStatus != "Completed")
    {
        <p>
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <em>@(currentStatus ?? "Processing...") (RequestId: @searchRequestId, Car: @make @model @year)</em>
        </p>
    }
    else if (currentStatus == "Completed")
    {
        <h3>Result</h3>
        <p>
            <strong>@result?.Car.Make @result?.Car.Model (@result?.Car.Year)</strong>
        </p>

        <p>
            <div class="mb-3">
                @((MarkupString)SummaryHtml)
            </div>
        </p>


        <h3>Sources</h3>
        @if (result?.Sources.Count > 0)
        {
            <ul>
                @foreach (var source in result.Sources)
                {
                    <li>

                        <p>
                            <strong><a href="@source.Url" target="_blank">@source.Title</a>(@source.Domain)</strong>
                        </p>
                    </li>
                }
            </ul>
        }
        else
        {
            <p><em>No sources available.</em></p>
        }
    }
}

@using Markdig

@code {
    private string make = string.Empty;
private string model = string.Empty;
private int year;

private int? searchRequestId;
private string? currentStatus;
private SearchRequestDto? result;
private string? errorMessage;
private bool isSubmitting;
private bool isAnalyzing => searchRequestId is not null && currentStatus != "Completed";
private string SummaryHtml =>
    result?.Summary is not null
        ? Markdown.ToHtml(result.Summary)
        : string.Empty;

private PeriodicTimer? pollTimer;
private CancellationTokenSource? pollCts;

private async Task StartAnalysis()
{
    errorMessage = null;
    result = null;
    currentStatus = null;
    isSubmitting = true;

    try
    {
        var client = HttpClientFactory.CreateClient("BackendApi");

        var request = new AnalyzeCarRequest
        {
            Make = make,
            Model = model,
            Year = year
        };

        var response = await client.PostAsJsonAsync("api/cars/analyze", request);

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"Error: {response.StatusCode}";
            return;
        }

        var analyzeResponse = await response.Content.ReadFromJsonAsync<AnalyzeCarResponse>();

        if (analyzeResponse is null)
        {
            errorMessage = "Unexpected server response.";
            return;
        }

        searchRequestId = analyzeResponse.SearchRequestId;
        currentStatus = analyzeResponse.Status;

        StartPolling(analyzeResponse.SearchRequestId);
    }
    catch (Exception ex)
    {
        errorMessage = $"Error submitting request: {ex.Message}";
    }
    finally
    {
        isSubmitting = false;
    }
}

private void StartPolling(int id)
{
    pollCts?.Cancel();
    pollCts = new CancellationTokenSource();
    pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(0.5));

    _ = PollLoop(id, pollTimer, pollCts.Token);
}

private async Task PollLoop(int id, PeriodicTimer timer, CancellationToken token)
{
    try
    {
        while (await timer.WaitForNextTickAsync(token))
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var dto = await client.GetFromJsonAsync<SearchRequestDto>($"api/searchrequests/{id}", token);

            if (dto is null)
            {
                continue;
            }

            currentStatus = dto.Status;

            if (dto.Status == "Completed")
            {
                result = dto;
                timer.Dispose();
                return;
            }

            await InvokeAsync(StateHasChanged);
        }
    }
    catch (OperationCanceledException)
    {
        // expected during Dispose/navigation away from the page
    }
    finally
    {
        await InvokeAsync(StateHasChanged);
    }
}

public void Dispose()
{
    pollCts?.Cancel();
    pollTimer?.Dispose();
}
}